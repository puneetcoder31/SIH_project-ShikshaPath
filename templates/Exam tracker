<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exam Countdown Tracker</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@600;700;700;700&display=swap');
        body {
            font-family: 'fantasy', serif;
            background: #25C6F7;
            overflow-y: auto;
        }
        .bubbles {
            position: fixed;
            top: 50; left: 50;
            width: 125%; height: 125%;
            z-index: -1;
            overflow: hidden;
        }
        .bubble {
            position: absolute;
            bottom: -100px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 10%;
            animation: rise 10s infinite ease-in;
        }
        @keyframes rise {
            0% { transform: translateY(0) scale(1); opacity: 0.6; }
            50% { opacity: 0.3; }
            100% { transform: translateY(-120vh) scale(1.5); opacity: 0; }
        }
    </style>
</head>
<body class="flex flex-col min-h-screen items-center p-4">

    <!-- Bubbly Background -->
    <div class="bubbles">
        <div class="bubble" style="width: 20px; height: 20px; left: 10%; animation-duration: 25s;"></div>
        <div class="bubble" style="width: 40px; height: 40px; left: 20%; animation-duration: 30s;"></div>
        <div class="bubble" style="width: 30px; height: 30px; left: 35%; animation-duration: 20s;"></div>
        <div class="bubble" style="width: 50px; height: 50px; left: 50%; animation-duration: 35s;"></div>
        <div class="bubble" style="width: 25px; height: 25px; left: 65%; animation-duration: 22s;"></div>
        <div class="bubble" style="width: 35px; height: 35px; left: 80%; animation-duration: 28s;"></div>
        <div class="bubble" style="width: 45px; height: 45px; left: 90%; animation-duration: 32s;"></div>
    </div>

    <!-- Main Container -->
    <div class="bg-white p-6 rounded-3xl shadow-xl w-full max-w-2xl mt-8 mb-12 relative z-10 border border-gray-200">
        <h1 class="text-3xl font-bold text-center text-sky-600 mb-2">EXAM COUNTDOWN</h1>
        <p class="text-center text-gray-500 mb-6">Stay motivated and on track for your exams.</p>
        
        <!-- Add Exam Form -->
        <form id="add-exam-form" class="flex flex-col sm:flex-row flex-wrap gap-4 mb-6">
            <input type="text" id="EXAM-NAME" placeholder="ENTER EXAM NAME (e.g., JEE Main)" class="flex-1 min-w-[200px] p-3 rounded-lg border-2 border-indigo-200 focus:ring-2 focus:ring-indigo-400 focus:border-indigo-400 transition duration-200" required>
            
            <div class="flex-1 flex flex-col gap-1 min-w-[160px]">
                <label for="start-date" class="text-sm font-medium text-RED-600">START DATE</label>
                <input type="date" id="start-date" class="p-3 rounded-lg border-2 border-purple-200 focus:ring-2 focus:ring-purple-400 focus:border-purple-400 transition duration-200" required>
            </div>
            
            <div class="flex-1 flex flex-col gap-1 min-w-[160px]">
                <label for="exam-date" class="text-sm font-medium text-RED-600">EXAM DATE</label>
                <input type="date" id="exam-date" class="p-3 rounded-lg border-2 border-sky-200 focus:ring-2 focus:ring-sky-400 focus:border-sky-400 transition duration-200" required>
            </div>
            
            <button type="submit" class="bg-gradient-to-r from-purple-500 to-indigo-500 text-white font-semibold p-3 rounded-lg hover:from-purple-600 hover:to-indigo-600 transition duration-200 shadow-md sm:mt-6">Add Exam</button>
        </form>

        <!-- Exam List -->
        <div id="exam-list" class="flex flex-col gap-4">
            <!-- Exams will be rendered here -->
            <div class="p-4 text-center text-gray-400 border border-dashed rounded-lg">No exams added yet.</div>
        </div>
    </div>

    <script>
        const form = document.getElementById('add-exam-form');
        const examNameInput = document.getElementById('EXAM-NAME');
        const startDateInput = document.getElementById('start-date');
        const examDateInput = document.getElementById('exam-date');
        const examList = document.getElementById('exam-list');

        let exams = JSON.parse(localStorage.getItem('exams')) || [];
        let countdownIntervals = {};

        // Function to save exams to localStorage
        function saveExams() {
            localStorage.setItem('exams', JSON.stringify(exams));
        }

        // Function to calculate and update countdown
        function updateCountdown(exam) {
            const now = new Date();
            const examDate = new Date(exam.date);
            const timeRemaining = examDate - now;

            if (timeRemaining <= 0) {
                exam.countdown = "Exam is today!";
                clearInterval(countdownIntervals[exam.id]);
            } else {
                const days = Math.floor(timeRemaining / (1000 * 60 * 60 * 24));
                const hours = Math.floor((timeRemaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((timeRemaining % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((timeRemaining % (1000 * 60)) / 1000);

                exam.countdown = `${days}d ${hours}h ${minutes}m ${seconds}s`;
            }

            renderExams();
        }
        
        // Function to calculate the number of days between two dates
        function calculateDuration(startDate, examDate) {
            const start = new Date(startDate);
            const end = new Date(examDate);
            const oneDay = 1000 * 60 * 60 * 24;
            const differenceMs = end - start;
            return Math.round(differenceMs / oneDay);
        }

        // Function to render exams on the page
        function renderExams() {
            examList.innerHTML = '';
            if (exams.length === 0) {
                examList.innerHTML = `<div class="p-4 text-center text-gray-400 border border-dashed rounded-lg">No exams added yet.</div>`;
                return;
            }

            exams.sort((a, b) => new Date(a.date) - new Date(b.date));

            exams.forEach(exam => {
                const examDiv = document.createElement('div');
                examDiv.className = 'flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white p-4 rounded-lg shadow-md border-t-4 border-indigo-400 transition-transform duration-300 transform hover:scale-[1.01] min-h-[120px]';
                examDiv.innerHTML = `
                    <div class="flex-1 mb-2 sm:mb-0">
                        <h2 class="text-lg font-semibold text-indigo-700">${exam.name}</h2>
                        <p class="text-sm text-gray-500">Exam Date: ${exam.date}</p>
                        <p class="text-sm text-gray-500">Start Date: ${exam.startDate}</p>
                        <p class="text-sm text-gray-500 mt-1 font-semibold">Total Study Period: ${exam.duration} days</p>
                    </div>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-2">
                        <p class="countdown-text text-lg font-bold text-indigo-600">${exam.countdown}</p>
                        <button class="remove-btn bg-red-500 text-white font-semibold py-1 px-3 rounded-lg hover:bg-red-600 transition duration-200 text-sm">Remove</button>
                    </div>
                `;

                examDiv.querySelector('.remove-btn').addEventListener('click', () => {
                    removeExam(exam.id);
                });

                examList.appendChild(examDiv);

                // Start or update countdown for this exam
                if (countdownIntervals[exam.id]) {
                    clearInterval(countdownIntervals[exam.id]);
                }
                countdownIntervals[exam.id] = setInterval(() => {
                    updateCountdown(exam);
                }, 1000);
                updateCountdown(exam); // Initial call
            });
        }

        // Function to add a new exam
        function addExam(e) {
            e.preventDefault();
            const examName = examNameInput.value.trim();
            const examDate = examDateInput.value;
            const startDate = startDateInput.value;
            const duration = calculateDuration(startDate, examDate);

            const newExam = {
                id: Date.now(),
                name: examName,
                date: examDate,
                startDate: startDate,
                duration: duration,
                countdown: ''
            };

            exams.push(newExam);
            saveExams();
            form.reset();
            renderExams();
        }

        // Function to remove an exam
        function removeExam(id) {
            exams = exams.filter(exam => exam.id !== id);
            saveExams();
            if (countdownIntervals[id]) {
                clearInterval(countdownIntervals[id]);
                delete countdownIntervals[id];
            }
            renderExams();
        }

        // Event listener for form submission
        form.addEventListener('submit', addExam);

        // Initial render
        renderExams();
    </script>

</body>
</html>
